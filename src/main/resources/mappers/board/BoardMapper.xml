<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.board.springboard.model.mapper.BoardMapper">

    <!-- 전체 게시물 조회 -->
    <select id="전체게시물" resultType="com.board.springboard.model.dto.Board">
    SELECT * FROM board ORDER BY board_no
        <!-- SQL을 작성하시오 -->
    </select>

    <!-- 게시물 하나 조회
    WHERE board_no = #{???}
    DEAAVER 의 SQL에서 하나의 게시물을 조회할경우 WHERE BOARD_NO = 1과 같이 작성
    JAVA 에서 클라이언트가 보고자하는 상세 게시물을 클라이언트 눈에 보여줄 필요가 있다

        WHERE board_no = #{???}
        #{???} = JSP에서 소비자가 선택한 번호를 백엔드로 넘겨받은
        소비자가 선택한 번호를 넘겨받은 백엔드는 SQL에 전달하기 위해 데이터를 담을 공간 필요
        데이터가 담길 공간을 com.board.springboard.model.dtp.Board  내부에 작성한
        변수 공간을 선택하고, 선택된 공간을 #{???} 공간의 명칭을 작성하는 것
    -->
    <select id="단일게시물" resultType="com.board.springboard.model.dto.Board">
        <!-- SQL을 작성하시오 -->
    SELECT* FROM board WHERE board_no = #{board_no}
    </select>

    <!-- 게시물 추가 -->
    <insert id="게시물추가" parameterType="com.board.springboard.model.dto.Board">
        <!-- SQL을 작성하시오 -->
    INSERT INTO  board(title, content, writer, create_at , view_count, attach_img)
    values (#{title}, #{content},#{writer}, NOW(),0 ,#{attach_img})
    </insert>

    <!-- 게시물 수정 -->
    <update id="게시물수정" parameterType="int">
        UPDATE board
        SET title = #{title}, content = #{content}
        WHERE board_no = #{board_no}
    </update>

    <!-- 게시물 삭제 -->
    <delete id="게시물삭제" parameterType="int">
        DELETE board
        WHERE board_no = #{board_no}
    </delete>

    <update id="조회수수정" parameterType="int">
        UPDATE board
        SET view_count = view_count + 1
        WHERE board_no = #{board_no}
    </update>

</mapper>